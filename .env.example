# Copy to .env and change the passwords:   cp .env.example .env
# .env is git-ignored. Never commit real passwords.

# Database (used by both the db and app containers)
DB_USERNAME=lablink
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# mysql,seed = demo accounts and sample data (local/demo)
# mysql      = empty database, schema only (production)
SPRING_PROFILES_ACTIVE=mysql,seed

# First lab-manager account on an empty production database. Remove after first start.
LABLINK_ADMIN_EMAIL=
LABLINK_ADMIN_PASSWORD=

# Host port the app is published on
APP_PORT=8080
