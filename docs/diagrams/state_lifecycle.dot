digraph state_lifecycle {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.65, bgcolor="white", pad=0.25, newrank=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#1f2933"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#52606d", fontcolor="#52606d", arrowsize=0.9];
  res [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«context»</FONT><BR/><B>Reservation</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">- state: ReservationState<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ approve(manager: User)<BR ALIGN="LEFT"/>+ deny(manager: User, reason: String)<BR ALIGN="LEFT"/>+ checkOut()<BR ALIGN="LEFT"/>+ returnItem()<BR ALIGN="LEFT"/>+ cancel()<BR ALIGN="LEFT"/>~ transitionTo(next: ReservationState)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  st [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#cfdff5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«interface · state»</FONT><BR/><B><I>ReservationState</I></B></TD></TR><TR><TD BGCOLOR="#e8f0fb" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ approve(r: Reservation)<BR ALIGN="LEFT"/>+ deny(r: Reservation, reason)<BR ALIGN="LEFT"/>+ checkOut(r: Reservation)<BR ALIGN="LEFT"/>+ returnItem(r: Reservation)<BR ALIGN="LEFT"/>+ cancel(r: Reservation)<BR ALIGN="LEFT"/>+ status(): ReservationStatus<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  base [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«abstract»</FONT><BR/><B>AbstractReservationState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">every action throws<BR ALIGN="LEFT"/>IllegalTransitionException<BR ALIGN="LEFT"/>unless a subclass overrides it<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  pend [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>PendingState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ approve(r)<BR ALIGN="LEFT"/>+ deny(r, reason)<BR ALIGN="LEFT"/>+ cancel(r)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  appr [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>ApprovedState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ checkOut(r)<BR ALIGN="LEFT"/>+ cancel(r)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  out [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>CheckedOutState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ returnItem(r)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  done [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>CompletedState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">(no transitions)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  canc [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>CancelledState / DeniedState</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">(no transitions)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  res -> st [dir=both, arrowtail=diamond, arrowhead=vee, label="  current state"];
  base -> st [style=dashed, arrowhead=empty];
  pend -> base [arrowhead=empty];
  appr -> base [arrowhead=empty];
  out -> base [arrowhead=empty];
  done -> base [arrowhead=empty];
  canc -> base [arrowhead=empty];
  {rank=same; pend; appr; out; done; canc;}
}