digraph ER {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.5, ranksep=1.3, pad=0.3, bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#444444", fontcolor="#222222", dir=both];
  departments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#3d8b5a"><font color="white"><b>departments</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="code">code</td><td align="left"><font color="#555555">VARCHAR(10)</font></td><td align="left" port="code_e"><font color="#8a4b08">UK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="name_e"><font color="#8a4b08">UK</font></td></tr></table>>];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#2f6f8f"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#555555">VARCHAR(255)</font></td><td align="left" port="email_e"><font color="#8a4b08">UK</font></td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="full_name_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="password_hash">password_hash</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="password_hash_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="role">role</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="role_e"><font color="#8a4b08">CHECK</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="created_at_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="department_id">department_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="department_id_e"><font color="#8a4b08">FK, null</font></td></tr></table>>];
  labs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#2f6f8f"><font color="white"><b>labs</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="name_e"><font color="#8a4b08">UK</font></td></tr><tr><td align="left" port="building">building</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="building_e"><font color="#8a4b08">UK1</font></td></tr><tr><td align="left" port="room_number">room_number</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="room_number_e"><font color="#8a4b08">UK1</font></td></tr><tr><td align="left" port="capacity">capacity</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="capacity_e"><font color="#8a4b08">CHECK &gt; 0</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">VARCHAR(500)</font></td><td align="left" port="description_e"><font color="#8a4b08">null</font></td></tr><tr><td align="left" port="active">active</td><td align="left"><font color="#555555">BOOLEAN</font></td><td align="left" port="active_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="department_id">department_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="department_id_e"><font color="#8a4b08">FK, null</font></td></tr></table>>];
  equipment_categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#3d8b5a"><font color="white"><b>equipment_categories</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">VARCHAR(50)</font></td><td align="left" port="name_e"><font color="#8a4b08">UK</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">VARCHAR(255)</font></td><td align="left" port="description_e"><font color="#8a4b08">null</font></td></tr><tr><td align="left" port="max_loan_hours">max_loan_hours</td><td align="left"><font color="#555555">INT</font></td><td align="left" port="max_loan_hours_e"><font color="#8a4b08">CHECK &gt; 0</font></td></tr></table>>];
  equipment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#2f6f8f"><font color="white"><b>equipment</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#555555">VARCHAR(100)</font></td><td align="left" port="name_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="serial_number">serial_number</td><td align="left"><font color="#555555">VARCHAR(50)</font></td><td align="left" port="serial_number_e"><font color="#8a4b08">UK</font></td></tr><tr><td align="left" port="description">description</td><td align="left"><font color="#555555">VARCHAR(500)</font></td><td align="left" port="description_e"><font color="#8a4b08">null</font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="status_e"><font color="#8a4b08">CHECK</font></td></tr><tr><td align="left" port="lab_id">lab_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="lab_id_e"><font color="#8a4b08">FK, null</font></td></tr><tr><td align="left" port="category_id">category_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="category_id_e"><font color="#8a4b08">FK, null</font></td></tr></table>>];
  reservations [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#2f6f8f"><font color="white"><b>reservations</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="user_id">user_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="user_id_e"><font color="#8a4b08">FK</font></td></tr><tr><td align="left" port="lab_id">lab_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="lab_id_e"><font color="#8a4b08">FK, null *</font></td></tr><tr><td align="left" port="equipment_id">equipment_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="equipment_id_e"><font color="#8a4b08">FK, null *</font></td></tr><tr><td align="left" port="start_time">start_time</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="start_time_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="end_time">end_time</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="end_time_e"><font color="#8a4b08">CHECK &gt; start</font></td></tr><tr><td align="left" port="purpose">purpose</td><td align="left"><font color="#555555">VARCHAR(255)</font></td><td align="left" port="purpose_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="status_e"><font color="#8a4b08">CHECK</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="created_at_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="reviewed_by_id">reviewed_by_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="reviewed_by_id_e"><font color="#8a4b08">FK, null</font></td></tr><tr><td align="left" port="reviewed_at">reviewed_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="reviewed_at_e"><font color="#8a4b08">null</font></td></tr></table>>];
  reservation_status_history [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#3d8b5a"><font color="white"><b>reservation_status_history</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="reservation_id">reservation_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="reservation_id_e"><font color="#8a4b08">FK</font></td></tr><tr><td align="left" port="old_status">old_status</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="old_status_e"><font color="#8a4b08">null</font></td></tr><tr><td align="left" port="new_status">new_status</td><td align="left"><font color="#555555">VARCHAR(20)</font></td><td align="left" port="new_status_e"><font color="#8a4b08">CHECK</font></td></tr><tr><td align="left" port="changed_by_id">changed_by_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="changed_by_id_e"><font color="#8a4b08">FK</font></td></tr><tr><td align="left" port="changed_at">changed_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="changed_at_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="note">note</td><td align="left"><font color="#555555">VARCHAR(255)</font></td><td align="left" port="note_e"><font color="#8a4b08">null</font></td></tr></table>>];
  maintenance_records [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#555555"><tr><td colspan="3" bgcolor="#3d8b5a"><font color="white"><b>maintenance_records</b></font></td></tr><tr><td align="left" port="id"><b>id</b></td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="id_e"><font color="#8a4b08">PK</font></td></tr><tr><td align="left" port="equipment_id">equipment_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="equipment_id_e"><font color="#8a4b08">FK</font></td></tr><tr><td align="left" port="reported_by_id">reported_by_id</td><td align="left"><font color="#555555">BIGINT</font></td><td align="left" port="reported_by_id_e"><font color="#8a4b08">FK</font></td></tr><tr><td align="left" port="issue">issue</td><td align="left"><font color="#555555">VARCHAR(500)</font></td><td align="left" port="issue_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="reported_at">reported_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="reported_at_e"><font color="#8a4b08"> </font></td></tr><tr><td align="left" port="resolved_at">resolved_at</td><td align="left"><font color="#555555">DATETIME</font></td><td align="left" port="resolved_at_e"><font color="#8a4b08">null</font></td></tr><tr><td align="left" port="resolution_notes">resolution_notes</td><td align="left"><font color="#555555">VARCHAR(500)</font></td><td align="left" port="resolution_notes_e"><font color="#8a4b08">null</font></td></tr></table>>];
  departments:id_e:e -> users:department_id:w [arrowtail=teeodot, arrowhead=crowodot, label="has members", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  departments:id_e:e -> labs:department_id:w [arrowtail=teeodot, arrowhead=crowodot, label="owns", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  labs:id_e:e -> equipment:lab_id:w [arrowtail=teeodot, arrowhead=crowodot, label="houses", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  equipment_categories:id_e:e -> equipment:category_id:w [arrowtail=teeodot, arrowhead=crowodot, label="classifies", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  users:id_e:e -> reservations:user_id:w [arrowtail=teetee, arrowhead=crowodot, label="makes", taillabel="1", headlabel="0..*", labeldistance=1.8];
  users:id_e:e -> reservations:reviewed_by_id:w [arrowtail=teeodot, arrowhead=crowodot, label="reviews", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  labs:id_e:e -> reservations:lab_id:w [arrowtail=teeodot, arrowhead=crowodot, label="reserved in", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  equipment:id_e:e -> reservations:equipment_id:w [arrowtail=teeodot, arrowhead=crowodot, label="reserved in", taillabel="0..1", headlabel="0..*", labeldistance=1.8];
  reservations:id_e:e -> reservation_status_history:reservation_id:w [arrowtail=teetee, arrowhead=crowtee, label="has history", taillabel="1", headlabel="1..*", labeldistance=1.8];
  users:id_e:e -> reservation_status_history:changed_by_id:w [arrowtail=teetee, arrowhead=crowodot, label="changes status", taillabel="1", headlabel="0..*", labeldistance=1.8];
  equipment:id_e:e -> maintenance_records:equipment_id:w [arrowtail=teetee, arrowhead=crowodot, label="has", taillabel="1", headlabel="0..*", labeldistance=1.8];
  users:id_e:e -> maintenance_records:reported_by_id:w [arrowtail=teetee, arrowhead=crowodot, label="reports", taillabel="1", headlabel="0..*", labeldistance=1.8];
  legend [label=<<table border="0" cellpadding="2"><tr><td align="left"><b>Legend</b></td></tr><tr><td align="left">Blue header = Milestone 2 table, green = added this week</td></tr><tr><td align="left">|| exactly one   o| zero or one   o&lt; zero or many   |&lt; one or many</td></tr><tr><td align="left">* exactly one of lab_id / equipment_id is set (CHECK)</td></tr><tr><td align="left">UK1 = (building, room_number) unique together</td></tr></table>>];
}
