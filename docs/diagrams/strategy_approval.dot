digraph strategy_approval {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.65, bgcolor="white", pad=0.25, newrank=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#1f2933"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#52606d", fontcolor="#52606d", arrowsize=0.9];
  svc [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«context»</FONT><BR/><B>ReservationService</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">- approvalPolicyResolver: ApprovalPolicyResolver<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ create(request: ReservationRequest): Reservation<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  res [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>ApprovalPolicyResolver</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">- policiesByRule: Map&lt;ApprovalRule, ApprovalPolicy&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ ApprovalPolicyResolver(policies: List&lt;ApprovalPolicy&gt;)<BR ALIGN="LEFT"/>+ policyFor(resource: Resource): ApprovalPolicy<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  pol [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#cfdff5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«interface · strategy»</FONT><BR/><B><I>ApprovalPolicy</I></B></TD></TR><TR><TD BGCOLOR="#e8f0fb" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ handles(): ApprovalRule<BR ALIGN="LEFT"/>+ evaluate(requester: User, resource: Resource): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  auto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>AutoApprovalPolicy</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ handles(): ApprovalRule<BR ALIGN="LEFT"/>+ evaluate(...): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  mgr [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>ManagerReviewPolicy</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ handles(): ApprovalRule<BR ALIGN="LEFT"/>+ evaluate(...): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  fac [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>FacultyOnlyPolicy</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ handles(): ApprovalRule<BR ALIGN="LEFT"/>+ evaluate(...): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  trn [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>TrainingRequiredPolicy</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ handles(): ApprovalRule<BR ALIGN="LEFT"/>+ evaluate(...): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  dec [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«record»</FONT><BR/><B>ApprovalDecision</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ outcome: Outcome<BR ALIGN="LEFT"/>+ reason: String<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ approved(): ApprovalDecision<BR ALIGN="LEFT"/>+ needsReview(reason): ApprovalDecision<BR ALIGN="LEFT"/>+ denied(reason): ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  rule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«enumeration»</FONT><BR/><B>ApprovalRule</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">AUTO<BR ALIGN="LEFT"/>MANAGER_REVIEW<BR ALIGN="LEFT"/>FACULTY_ONLY<BR ALIGN="LEFT"/>TRAINING_REQUIRED<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR></TABLE>>];
  svc -> res [arrowhead=vee, label="uses"];
  res -> pol [dir=both, arrowtail=odiamond, arrowhead=vee, label="  1..*"];
  auto -> pol [style=dashed, arrowhead=empty];
  mgr -> pol [style=dashed, arrowhead=empty];
  fac -> pol [style=dashed, arrowhead=empty];
  trn -> pol [style=dashed, arrowhead=empty];
  pol -> dec [style=dashed, arrowhead=vee, label="  returns"];
  res -> rule [style=dashed, arrowhead=vee, label="keyed by"];
  {rank=same; auto; mgr; fac; trn;}
}