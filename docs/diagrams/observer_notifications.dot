digraph observer_notifications {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.45, ranksep=0.65, bgcolor="white", pad=0.25, newrank=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11, fontcolor="#1f2933"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#52606d", fontcolor="#52606d", arrowsize=0.9];
  svc [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«subject (publisher)»</FONT><BR/><B>ReservationService</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">- events: ApplicationEventPublisher<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ create(request): Reservation<BR ALIGN="LEFT"/>+ cancel(id): Reservation<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  pub [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f3e1bd" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«interface · Spring»</FONT><BR/><B>ApplicationEventPublisher</B></TD></TR><TR><TD BGCOLOR="#fbf3e4" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#fbf3e4" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ publishEvent(event: Object)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  evt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«record · event»</FONT><BR/><B>ReservationStatusChangedEvent</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ reservation: Reservation<BR ALIGN="LEFT"/>+ previousStatus: ReservationStatus<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR></TABLE>>];
  bus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f3e1bd" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«Spring»</FONT><BR/><B>Spring event multicaster</B></TD></TR><TR><TD BGCOLOR="#fbf3e4" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#fbf3e4" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">finds every @TransactionalEventListener<BR ALIGN="LEFT"/>method and calls it<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  notif [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«observer»</FONT><BR/><B>ReservationNotificationListener</B></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">- sender: NotificationSender<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">@TransactionalEventListener<BR ALIGN="LEFT"/>+ onStatusChanged(event)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  audit [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d" STYLE="dashed"><TR><TD BGCOLOR="#e4e7eb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«observer»</FONT><BR/><B>AuditLogListener</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">@TransactionalEventListener<BR ALIGN="LEFT"/>+ onStatusChanged(event)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#52606d"><I>planned</I></FONT></TD></TR></TABLE>>];
  avail [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d" STYLE="dashed"><TR><TD BGCOLOR="#e4e7eb" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«observer»</FONT><BR/><B>AvailabilityCacheListener</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">@TransactionalEventListener<BR ALIGN="LEFT"/>+ onStatusChanged(event)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#52606d"><I>planned</I></FONT></TD></TR></TABLE>>];
  send [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#cfdff5" CELLPADDING="5"><FONT POINT-SIZE="9" COLOR="#52606d">«interface»</FONT><BR/><B><I>NotificationSender</I></B></TD></TR><TR><TD BGCOLOR="#e8f0fb" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ send(to, subject, body)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  log [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d"><TR><TD BGCOLOR="#f1f3f5" CELLPADDING="5"><B>LogNotificationSender</B></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ send(to, subject, body)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#52606d"><I>dev / tests</I></FONT></TD></TR></TABLE>>];
  mail [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#52606d" STYLE="dashed"><TR><TD BGCOLOR="#e4e7eb" CELLPADDING="5"><B>EmailNotificationSender</B></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="2"> </TD></TR><TR><TD BGCOLOR="#f7f7f7" ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10">+ send(to, subject, body)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#f7f7f7" CELLPADDING="4"><FONT POINT-SIZE="9" COLOR="#52606d"><I>planned for production</I></FONT></TD></TR></TABLE>>];
  svc -> pub [arrowhead=vee, label="  publishes via"];
  svc -> evt [style=dashed, arrowhead=vee, label="creates"];
  pub -> bus [arrowhead=vee, label="  delivers to"];
  bus -> notif [style=dashed, arrowhead=vee, label="notifies"];
  bus -> audit [style=dashed, arrowhead=vee];
  bus -> avail [style=dashed, arrowhead=vee];
  notif -> send [arrowhead=vee, label="  uses"];
  log -> send [style=dashed, arrowhead=empty];
  mail -> send [style=dashed, arrowhead=empty];
  {rank=same; svc; evt;}
  {rank=same; notif; audit; avail;}
  {rank=same; log; mail;}
}