digraph packages {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.75, pad=0.3, bgcolor="white", newrank=true];
  node [shape=plaintext, fontname="DejaVu Sans", fontcolor="#1f2933"];
  edge [color="#52606d", style=dashed, arrowhead=vee, arrowsize=0.9, fontname="DejaVu Sans", fontsize=9, fontcolor="#52606d"];
  web [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#5f8f5f"><TR><TD BGCOLOR="#5f8f5f" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.web  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#eef6ee" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>HTTP in, JSON out. No business rules.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ReservationController<BR ALIGN="LEFT"/>ReservationResponse<BR ALIGN="LEFT"/>ApiExceptionHandler<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  res [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#4f76b0"><TR><TD BGCOLOR="#4f76b0" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.reservation  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e8f0fb" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Booking workflow: create, cancel, conflicts.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ReservationService<BR ALIGN="LEFT"/>ReservationConflictChecker<BR ALIGN="LEFT"/>Reservation, ReservationStatus<BR ALIGN="LEFT"/>ReservationRequest<BR ALIGN="LEFT"/>ReservationRepository<BR ALIGN="LEFT"/>ReservationStatusChangedEvent<BR ALIGN="LEFT"/>ReservationConflictException<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  appr [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#4f76b0"><TR><TD BGCOLOR="#4f76b0" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.reservation.approval  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e8f0fb" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Approval rules (Strategy pattern).</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ApprovalPolicy  «interface»<BR ALIGN="LEFT"/>AutoApprovalPolicy<BR ALIGN="LEFT"/>ManagerReviewPolicy<BR ALIGN="LEFT"/>FacultyOnlyPolicy<BR ALIGN="LEFT"/>TrainingRequiredPolicy<BR ALIGN="LEFT"/>ApprovalPolicyResolver<BR ALIGN="LEFT"/>ApprovalDecision<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  rep [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#4f76b0"><TR><TD BGCOLOR="#4f76b0" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.reservation.report  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e8f0fb" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Lab-manager reports.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ReservationCsvExporter<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  notif [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#b08a3e"><TR><TD BGCOLOR="#b08a3e" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.notification  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#fbf3e4" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Telling people what happened (Observer).</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ReservationNotificationListener<BR ALIGN="LEFT"/>NotificationSender  «interface»<BR ALIGN="LEFT"/>LogNotificationSender<BR ALIGN="LEFT"/><FONT COLOR="#7b8794"><I>EmailNotificationSender (planned)</I></FONT><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  inv [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#7d66a8"><TR><TD BGCOLOR="#7d66a8" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.inventory  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f3eefa" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Labs and equipment.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">Resource<BR ALIGN="LEFT"/>ResourceType<BR ALIGN="LEFT"/>ApprovalRule<BR ALIGN="LEFT"/>ResourceRepository<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  auth [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#b06b6b"><TR><TD BGCOLOR="#b06b6b" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.auth  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#fdeeee" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>Users, roles, login.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">User<BR ALIGN="LEFT"/>Role<BR ALIGN="LEFT"/>UserRepository<BR ALIGN="LEFT"/><FONT COLOR="#7b8794"><I>SecurityConfig (auth branch)</I></FONT><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  cfg [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#7b8794"><TR><TD BGCOLOR="#7b8794" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="10"><B>  edu.campbellsville.lablink.config  </B></FONT></TD><TD BORDER="0"> </TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f3f5" ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="9" COLOR="#52606d"><I>App-wide beans.</I></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10">ClockConfig<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  web -> res [label=" calls service"];
  res -> appr [label=" asks policy"];
  rep -> res [label=" reads"];
  notif -> res [label=" listens for events"];
  res -> inv [label=" reads"];
  res -> auth [label=" reads"];
  appr -> inv;
  appr -> auth;
  res -> cfg [label=" Clock"];
  {rank=same; res; rep; notif;}
  {rank=same; appr; cfg;}
  {rank=same; inv; auth;}
}